<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.utilityfinder.ui.controller.WorkspaceManagerController"
      prefWidth="480" prefHeight="580" spacing="12"
      style="-fx-padding: 20; -fx-background-color: white;">

    <!-- ── Workspace list ─────────────────────────────────────────────────── -->
    <Label text="Workspaces" style="-fx-font-size: 15; -fx-font-weight: bold;"/>

    <ListView fx:id="workspaceList" prefHeight="130"/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="+ New"  onAction="#handleNew"    mnemonicParsing="false"/>
        <Button fx:id="btnRename" text="Rename  F2" onAction="#handleRename" mnemonicParsing="false"/>
        <Button fx:id="btnDelete" text="Delete  Del" onAction="#handleDelete" mnemonicParsing="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Done"   onAction="#handleClose"  defaultButton="true" mnemonicParsing="false"/>
    </HBox>

    <Label text="F2 rename  •  Del delete  •  arrows navigate"
           style="-fx-text-fill: #95a5a6; -fx-font-size: 11;"/>

    <Separator/>

    <!-- ── Delivery Carrier section ──────────────────────────────────────── -->
    <VBox fx:id="tdspPane" spacing="10" visible="false" managed="false">

        <Label fx:id="tdspSectionTitle"
               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <!-- ZIP lookup row -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="ZIP Code" minWidth="80"/>
            <TextField fx:id="zipField" prefColumnCount="7" promptText="e.g. 77001"/>
            <Button text="Look Up" onAction="#handleZipLookup" mnemonicParsing="false"/>
        </HBox>

        <!-- Carrier dropdown -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Carrier" minWidth="80"/>
            <ComboBox fx:id="tdspCombo" prefWidth="230" onAction="#handleTdspSelected"/>
        </HBox>

        <!-- Detection indicator -->
        <Label fx:id="detectionLabel"
               style="-fx-text-fill: #27ae60; -fx-font-size: 11;"
               visible="false" managed="false"/>

        <!-- Rate display box -->
        <VBox fx:id="ratesBox" spacing="4"
              style="-fx-border-color: #d5d8dc; -fx-border-radius: 4;
                     -fx-background-color: #f8f9fa; -fx-background-radius: 4;
                     -fx-padding: 10 12;">

            <HBox spacing="8">
                <Label text="Base charge" minWidth="130"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                <Label fx:id="baseChargeLabel" style="-fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="8">
                <Label text="Distribution" minWidth="130"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"/>
                <Label fx:id="perKwhLabel" style="-fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="8" VBox.vgrow="NEVER">
                <Label fx:id="lastVerifiedLabel"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Edit Rates" onAction="#handleEditRates"
                        style="-fx-font-size: 10;" mnemonicParsing="false"/>
            </HBox>
        </VBox>

        <!-- Check for Updates button -->
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <Label fx:id="fetchStatusLabel"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11;"
                   visible="false" managed="false"/>
            <Button fx:id="btnCheckUpdates" text="Check for Updates"
                    onAction="#handleCheckForUpdates" mnemonicParsing="false"/>
        </HBox>

    </VBox>

</VBox>
